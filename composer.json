{
  "name": "andreasbvillumsen/laraconfig",
  "description": "Per-user settings repository system for Laravel",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "authors": [
    {
      "name": "Italo Baeza C.",
      "email": "darkghosthunter@gmail.com"
    },
    {
      "name": "Andreas Villumsen",
      "email": "andreasbendorff@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "illuminate/database": "^v11.42.1",
    "illuminate/support": "^v11.42.1",
    "illuminate/collections": "^v11.42.1",
    "illuminate/config": "^v11.42.1",
    "illuminate/cache": "^v11.42.1",
    "symfony/console": "^v7.2.1"
  },
  "require-dev": {
    "mockery/mockery": "^1.2.4",
    "orchestra/testbench": "^v9.10.0",
    "phpunit/phpunit": "^11.5.7"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "autoload": {
    "psr-4": {
      "andreasbvillumsen\\Laraconfig\\": "src"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "andreasbvillumsen\\Laraconfig\\LaraconfigServiceProvider"
      ],
      "aliases": {
        "Setting": "andreasbvillumsen\\Laraconfig\\Facades\\Setting"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --coverage-clover build/logs/clover.xml",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "config": {
    "sort-packages": true
  }
}
